# Copy to `.env`. The app and worker load this file on startup.
# A variable already set in the shell wins.
#
# Linux/macOS:
#   set -a && source .env && set +a
# PowerShell:
#   Get-Content .env | ForEach-Object {
#     if ($_ -match '^\s*([^#][^=]+)=(.*)$') {
#       Set-Item -Path "Env:$($matches[1].Trim())" -Value $matches[2].Trim('"')
#     }
#   }

# --- Local defaults (optional; omitted vars use these) ---

PORT=43781
DATABASE_URL=sqlite://ecclesia.db

# Boot seeds Grace Fellowship (search "Grace" on create account).
# Sign in as admin@seed.test with password `password`. Restart resets that password.

# Stable session cookies across restarts. Generate: openssl rand -hex 32
# ECCLESIA_SECRET=

# Link targets in mail when you test Resend locally
# ECCLESIA_PUBLIC_URL=http://127.0.0.1:43781

# Set on HTTPS hosts (Fly sets TLS; use 1 behind your own reverse proxy too)
# ECCLESIA_SECURE=1

# --- Public host (Fly sets FLY_APP_NAME; or set ECCLESIA_PUBLIC=1 locally) ---

# ECCLESIA_PUBLIC=1
# DATABASE_URL=postgres://USER:PASSWORD@HOST/DB?sslmode=require
# UPSTASH_REDIS_URL=rediss://default:TOKEN@HOST.upstash.io:6379
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM=Ecclesia <mail@yourdomain.com>
# ECCLESIA_PUBLIC_URL=https://your-app.fly.dev
# ECCLESIA_SECRET=64_hex_chars_from_openssl_rand

# --- Web Push (required on a shared host; local dev uses a built-in dev key) ---

# ECCLESIA_VAPID_PEM=./ecclesia-vapid.pem
# ECCLESIA_VAPID_PUBLIC=base64url_public_key
# ECCLESIA_FCM_KEY=

# --- Voice (optional; JudgeHub uses the word gate until a later spec) ---

# ECCLESIA_JEV_KEY=
# ECCLESIA_JEV_URL=https://jevtypesafeai.com/api/v1/decide
# ECCLESIA_JEV_MODEL=jev-latest
# ECCLESIA_OPENROUTER_KEY=
# OPENROUTER_API_KEY=
# ECCLESIA_OPENROUTER_URL=https://openrouter.ai/api/v1
# ECCLESIA_OPENROUTER_MODEL=openrouter/free
# ECCLESIA_LLM_URL=http://127.0.0.1:11434
# ECCLESIA_LLM_MODEL=llama3.1:8b
# ECCLESIA_LLM_KEY=
# ECCLESIA_REFINE_MODEL=

# --- Worker (same store and mail vars as the app) ---

# cargo run -p ecclesia --bin ecclesia-worker

# --- Logging ---

# RUST_LOG=ecclesia=info,tower_http=info
